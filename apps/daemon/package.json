{
	"name": "daemon",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun src/main.ts",
		"test": "bun test",
		"test:integration": "find ./src -name '*.integration-spec.ts' -type f -exec bun test {} +",
		"format:force": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"check-types": "tsc --noEmit",
