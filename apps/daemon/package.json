		"db:migrate": "bunx drizzle-kit migrate",
		"db:studio": "bunx drizzle-kit studio"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^1.0.0-rc.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@repo/ipc": "*",
		"dayjs": "^1.11.21",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"zod": "^4.4.3"
	}
}
