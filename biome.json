{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": [
    "@caioms/biomejs-config/biome"
  ],
  "linter": {
    "rules": {
      "style": {
        "useImportType": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!**/node_modules",
      "!**/dist",
      "!**/public",
      "!*.js",
      "!*.d.ts",
      "!apps/daemon/.drizzle",
      "!apps/daemon/bin",
      "!apps/daemon/data"
    ]
  }
}