{
	"compilerOptions": {
		"types": ["@types/bun", "bun-types/test-globals"],
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", "apps", "packages"]
}
